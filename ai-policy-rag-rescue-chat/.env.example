# Copy this file to .env, then replace only the MongoDB placeholders.
NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string and database for this module.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/rescue_policies?retryWrites=true&w=majority

# Local Ollama service and models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Retrieval settings.
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.65
CHUNK_SIZE=800
CHUNK_OVERLAP=150
