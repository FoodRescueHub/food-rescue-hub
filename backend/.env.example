# ============================================================
# Community Food Rescue — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the real values.
# Never commit .env to Git — it is already in .gitignore.
# ============================================================

# ── MongoDB Atlas ────────────────────────────────────────────
# Connection string from Atlas → Connect → Drivers.
# Replace <username>, <password>, and <cluster-url>.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/food_rescue?retryWrites=true&w=majority

# ── JSON Web Token ───────────────────────────────────────────
# Use a long, random string (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# Token expiry — examples: 1d, 8h, 60m
JWT_EXPIRES_IN=1d

# ── Server ───────────────────────────────────────────────────
PORT=5000
