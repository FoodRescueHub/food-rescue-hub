# Keep this file as a template. Never commit backend/.env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/rescue_policies?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=replace-with-a-long-random-value

# Local Ollama configuration for approved-policy RAG.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.65
CHUNK_SIZE=800
CHUNK_OVERLAP=150
